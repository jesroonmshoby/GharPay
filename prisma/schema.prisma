// Prisma schema file for GharPay - ODR Platform
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TENANT
  LANDLORD
  MEDIATOR
  ADMIN
}

enum DisputeStatus {
  DRAFT
  SUBMITTED
  EVIDENCE_REVIEW
  CALCULATED
  TENANT_REVIEW
  NEGOTIATION
  MEDIATOR_REVIEW
  SETTLEMENT_PENDING
  SETTLED
  REJECTED
}

enum ClaimCategory {
  PAINTING
  FIXTURE
  UTILITIES
  UNPAID_RENT
  CLEANING
}

enum ClaimStatus {
  PENDING
  SUPPORTED
  PARTIAL
  INSUFFICIENT
  APPROVED
  REJECTED
}

enum EvidenceType {
  PHOTO
  INVOICE
  RECEIPT
  AGREEMENT
  METER_READING
  MESSAGE
  OTHER
}

enum VerificationStatus {
  PENDING
  SUPPORTED
  PARTIAL
  INSUFFICIENT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

enum AuditAction {
  CASE_CREATED
  CASE_SUBMITTED
  EVIDENCE_UPLOADED
  CALCULATION_GENERATED
  OFFER_CREATED
  OFFER_ACCEPTED
  ROUND_COMPLETED
  MEDIATOR_ASSIGNED
  SETTLEMENT_CREATED
  TENANT_CONSENTED
  LANDLORD_CONSENTED
  PDF_GENERATED
  CASE_SETTLED
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  phone             String?
  passwordHash      String?
  role              UserRole
  landlordTenancies Tenancy[]  @relation("LandlordTenancies")
  tenantTenancies   Tenancy[]  @relation("TenantTenancies")
  initiatedDisputes Dispute[]
  uploadedEvidence  Evidence[]
  offers            Offer[]
  auditLogs         AuditLog[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Property {
  id           String    @id @default(uuid())
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String?
  tenancies    Tenancy[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Tenancy {
  id              String    @id @default(uuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id])
  landlordId      String
  landlord        User      @relation("LandlordTenancies", fields: [landlordId], references: [id])
  tenantId        String
  tenant          User      @relation("TenantTenancies", fields: [tenantId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  monthlyRent     Decimal   @db.Decimal(12, 2)
  securityDeposit Decimal   @db.Decimal(12, 2)
  agreementUrl    String?
  disputes        Dispute[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Dispute {
  id                  String        @id @default(uuid())
  caseNumber          String        @unique
  tenancyId           String
  status              DisputeStatus @default(DRAFT)
  initiatedBy         String
  totalDeposit        Decimal       @db.Decimal(12, 2)
  claimedDeduction    Decimal       @db.Decimal(12, 2)
  calculatedDeduction Decimal?      @db.Decimal(12, 2)
  tenantOffer         Decimal?      @db.Decimal(12, 2)
  landlordOffer       Decimal?      @db.Decimal(12, 2)
  currentRound        Int           @default(0)
  settlementEligible  Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenancy             Tenancy       @relation(fields: [tenancyId], references: [id])
  initiator           User          @relation(fields: [initiatedBy], references: [id])
  claims              Claim[]
  offers              Offer[]
  auditLogs           AuditLog[]
  settlement          Settlement?

  @@index([tenancyId])
  @@index([initiatedBy])
  @@index([status])
}

model Claim {
  id                     String        @id @default(uuid())
  disputeId              String
  category               ClaimCategory
  description            String
  claimedAmount          Decimal       @db.Decimal(12, 2)
  approvedAmount         Decimal?      @db.Decimal(12, 2)
  status                 ClaimStatus   @default(PENDING)
  calculationExplanation String?       @db.Text
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  dispute                Dispute       @relation(fields: [disputeId], references: [id])
  evidence               Evidence[]

  @@index([disputeId])
  @@index([category])
  @@index([status])
}

model Evidence {
  id                 String             @id @default(uuid())
  claimId            String
  uploadedBy         String
  type               EvidenceType
  fileUrl            String
  description        String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  claim              Claim              @relation(fields: [claimId], references: [id])
  uploader           User               @relation(fields: [uploadedBy], references: [id])

  @@index([claimId])
  @@index([uploadedBy])
  @@index([verificationStatus])
}

model Offer {
  id          String      @id @default(uuid())
  disputeId   String
  createdBy   String
  amount      Decimal     @db.Decimal(12, 2)
  roundNumber Int
  message     String?
  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  dispute     Dispute     @relation(fields: [disputeId], references: [id])
  creator     User        @relation(fields: [createdBy], references: [id])

  @@index([disputeId])
  @@index([createdBy])
  @@index([roundNumber])
}

model Settlement {
  id                  String    @id @default(uuid())
  disputeId           String    @unique
  agreedDeduction     Decimal   @db.Decimal(12, 2)
  refundAmount        Decimal   @db.Decimal(12, 2)
  consentTenant       Boolean   @default(false)
  consentLandlord     Boolean   @default(false)
  tenantConsentedAt   DateTime?
  landlordConsentedAt DateTime?
  pdfUrl              String?
  settlementHash      String?
  createdAt           DateTime  @default(now())
  dispute             Dispute   @relation(fields: [disputeId], references: [id])
}

model AuditLog {
  id        String      @id @default(uuid())
  disputeId String
  userId    String
  action    AuditAction
  metadata  Json?
  timestamp DateTime    @default(now())
  dispute   Dispute     @relation(fields: [disputeId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@index([disputeId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
}
